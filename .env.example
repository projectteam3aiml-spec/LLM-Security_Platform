# Copy this file to .env in the repo root, fill in real values, then run:
#   docker compose up --build

# --- Backend (app/core/config.py) ---
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- JWT auth ---
# SECRET_KEY above also signs JWTs (see app/core/security.py) -- no separate
# JWT secret, to keep this lean.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Default admin user, seeded on first startup if the users table is empty
# (see app/services/auth_service.py) -- change DEFAULT_ADMIN_PASSWORD before
# running this anywhere beyond local development.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me-immediately

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=llm_security_db
# POSTGRES_SERVER/POSTGRES_PORT are NOT read from here -- docker-compose.yml sets
# them directly to the "db" service name/5432 so the backend always finds Postgres
# over the compose network regardless of what's in this file.

# --- Frontend (baked in at build time, not at container start) ---
VITE_API_URL=http://localhost:8000/api/v1

# --- Optional API keys used by app/core/config.py ---
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
